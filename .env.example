# Copy this file to .env and fill in your own values. Never commit .env itself.

# Hugging Face token (read/write) — used for model download/login and pushing to the Hub
HF_TOKEN=

# Optional: Weights & Biases API key, for training run logging
WANDB_API_KEY=

# Optional: API key for the LLM used to generate QA pairs from scraped articles
QA_GEN_API_KEY=
